{
  "name": "portfolio-lynx-pardelle-aws-infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK JavaScript infrastructure plan and scaffold for the Lynx Pardelle portfolio backend migration.",
  "bin": {
    "portfolio-aws-infra": "bin/portfolio-aws-infra.js"
  },
  "scripts": {
    "cdk": "cdk",
    "test": "node --test",
    "synth": "cdk synth",
    "synth:dev": "cdk synth \"PortfolioDev/*\"",
    "synth:tst": "cdk synth \"PortfolioTst/*\"",
    "synth:prod": "cdk synth \"PortfolioProd/*\"",
    "diff:dev": "cdk diff \"PortfolioDev/*\"",
    "diff:tst": "cdk diff \"PortfolioTst/*\"",
    "diff:prod": "cdk diff \"PortfolioProd/*\"",
    "migration:inspect": "node scripts/migration/inspect-mongo-dump.js",
    "migration:export": "node scripts/migration/export-dynamodb-batch-items.js",
    "validate": "npm run synth"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1164.0",
    "@aws-sdk/client-ssm": "^3.1164.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "aws-cdk-lib": "^2.275.0",
    "bson": "^7.3.0",
    "constructs": "^10.8.1",
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "aws-cdk": "^2.1148.0",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
